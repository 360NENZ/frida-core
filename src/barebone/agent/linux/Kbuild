MODULE_NAME ?= meshlink-agent

obj-m += $(MODULE_NAME).o

# meshlink-agent-prelinked.o is not built from source here: it is the Rust agent, the
# GumJS devkit and the C library collapsed into a single relocatable object by the prelink
# step in Makefile. Copy it in through if_changed rather than kbuild's _shipped rule,
# so the .cmd file modpost expects gets written.
$(MODULE_NAME)-y := meshlink-kmod.o meshlink-agent-prelinked.o

targets += meshlink-agent-prelinked.o

quiet_cmd_meshlink_agent_prelinked = COPY    $@
      cmd_meshlink_agent_prelinked = cp $< $@

$(obj)/meshlink-agent-prelinked.o: $(src)/meshlink-agent-prelinked.o.bin FORCE
	$(call if_changed,meshlink_agent_prelinked)

# On x86 objtool validates every object going into a module and generates its ORC
# unwind tables. It was not built to read a JavaScript runtime linked against a
# freestanding libc: it gives up on the first Rust switch jump table it cannot
# follow, and the tables would only ever describe frames no kernel stack trace walks
# into. Both the blob and the module object it is linked into have to be excused,
# since objtool runs over each.
OBJECT_FILES_NON_STANDARD_meshlink-agent-prelinked.o := y
OBJECT_FILES_NON_STANDARD_$(MODULE_NAME).o := y

ccflags-y += $(FRIDA_KMOD_DEFS)
